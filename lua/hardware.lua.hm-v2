-- Hardware & Monitor (Official 0.55 Lua Syntax)

-- Monitor Configuration
hl.monitor({
    output   = "desc:ASUSTek COMPUTER INC XG27ACS SBLMTF097654",
    mode     = "2560x1440@180",
    position = "auto",
    scale    = "1",
})

-- HDMI (Optional backup)
hl.monitor({
    output   = "HDMI-A-1",
    mode     = "preferred",
    position = "auto",
    scale    = "1",
})

-- General Input Config
hl.config({
    input = {
        kb_layout = "tr",
        follow_mouse = 1,
        sensitivity = 0,
        accel_profile = "flat",
    },
    general = {
        gaps_in = 5,
        gaps_out = 10,
        border_size = 2,
    },
    cursor = {
        no_hardware_cursors = false,
    }
})

-- Envs
os.execute("export WLR_NO_HARDWARE_CURSORS=0")
os.execute("export AMD_DEBUG=radeonsi")
